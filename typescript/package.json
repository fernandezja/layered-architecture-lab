{
  "name": "urban-mobility-layered-architecture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:console": "tsx src/ui/console/ConsoleMain.ts",
    "dev:api": "tsx src/ui/api/ApiServer.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:console": "node dist/ui/console/ConsoleMain.js",
    "start:api": "node dist/ui/api/ApiServer.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.39",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
